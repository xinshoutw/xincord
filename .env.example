# Copy this file to .env next to compose.yaml and set your own values; git and the image leave
# .env out.

# The Lavalink node's password. Set the same in bot/plugins/MusicPlayer/config.yaml
# (lavalink.password).
LAVALINK_PASSWORD=change-me

# Spotify links through LavaSrc, off by default (https://developer.spotify.com/dashboard):
# SPOTIFY_ENABLED=true
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_COUNTRY_CODE=TW
