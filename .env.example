# Copy this file to .env next to compose.yaml and set your own values; git and the image leave
# .env out.

# The bot token (Discord developer portal, Bot): here rather than in config.yaml, which then
# holds no secret. It overrides config.yaml's token.
# XINCORD_TOKEN=

# The xincord release to run (https://github.com/xinshoutw/xincord/releases): pin one in production.
# Unset, `docker compose pull` takes the newest image.
# XINCORD_VERSION=0.3.1

# MusicPlayer's Lavalink node runs with the music profile; leave it off without MusicPlayer.
# COMPOSE_PROFILES=music

# The Lavalink node's password; compose asks for one even without the music profile. Set the
# same in plugins/MusicPlayer/config.yaml (lavalink.password).
LAVALINK_PASSWORD=change-me

# The bot's time zone, an IANA name: Giveaway's typed end times, Ticket's archive times and
# NtustAnnouncements' {{now}} use it. UTC when unset.
# TZ=Asia/Taipei

# Spotify links through LavaSrc, off by default (https://developer.spotify.com/dashboard):
# SPOTIFY_ENABLED=true
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_COUNTRY_CODE=TW

# YouTube's sign-in, for videos that YouTube plays only to a signed-in client ("This video requires
# login" in the node's log). Use a spare Google account: YouTube may suspend accounts used this way.
# Set YOUTUBE_OAUTH_ENABLED=true and recreate the node (docker compose up -d lavalink); its log gives
# an address and a code: open it with the account. The log then shows the refresh token: set it
# here, recreate the node, and it signs in at each start without asking.
# YOUTUBE_OAUTH_ENABLED=true
# YOUTUBE_OAUTH_REFRESH_TOKEN=

# The server that solves YouTube's signatures for the node: by default the public one of yt-cipher's
# author. For your own, run ghcr.io/kikkia/yt-cipher (with OVERRIDE_PLAYER_VARIANT=IAS and API_TOKEN
# as its password) where the node reaches it, and set:
# YOUTUBE_CIPHER_URL=http://yt-cipher:8001/
# YOUTUBE_CIPHER_PASSWORD=
